rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Current CRM stage: any authenticated Firebase user can access admin data.
    // Before enabling separate Client Login, replace these with role-based rules.

    match /agreements/{agreementId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /clients/{clientId} {
      allow read, create, update, delete: if request.auth != null;
    }

    match /companySettings/{documentId} {
      allow read, create, update: if request.auth != null;
    }

    match /properties/{propertyId} {
  allow read, create, update, delete: if request.auth != null;
}
  }
}
